---
import Base from '../layouts/Base.astro';
import { PRODUCTO_CARDS } from '../data/productos';
---

<Base title="Energía limpia para tu faena">

<!-- ═══════════════════════════════════════════════════════════
     1. HERO
     ═══════════════════════════════════════════════════════════ -->
<section class="hero">
  <div class="hero__bg">
    <img src="/img/hero-enertainer-faena.jpg" alt="" loading="eager" />
  </div>
  <div class="wrap hero__inner">
    <div class="hero__badge reveal">
      Representante oficial de
      <img src="/img/ampd-logo-white.svg" alt="Ampd Energy" class="hero__ampd-logo" />
      en Chile
    </div>
    <h1 class="h-xl reveal">Energía limpia y confiable para tu faena</h1>
    <p class="lead reveal">Reemplaza el generador diésel con sistemas de almacenamiento de energía en baterías. Más silencioso, sin emisiones, hasta 80&nbsp;% menos costo operativo.</p>
    <div class="ctas reveal">
      <a href="#cotizar" class="btn btn-primary">
        Cotiza tu proyecto
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a href="#productos" class="btn btn-outline">Ver productos</a>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     2. STATEMENT
     ═══════════════════════════════════════════════════════════ -->
<section class="section" id="statement">
  <div class="wrap statement">
    <h2 class="h-lg reveal" style="max-width:26ch">Sistemas de baterías de clase mundial que reemplazan generadores diésel en faenas exigentes.</h2>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     3. PILARES / WHY AMPD
     ═══════════════════════════════════════════════════════════ -->
<section class="section section-dark" id="ventajas">
  <div class="wrap">
    <p class="eyebrow reveal" style="color:var(--green)">Por qué Ampd</p>
    <h2 class="h-md reveal" style="margin-top:16px">Ventajas que se notan desde el primer día</h2>

    <div class="pilares-grid">

      <!-- Card 1 -->
      <div class="pilar-card reveal">
        <div class="pilar-card__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
        </div>
        <h3>Sin interrupciones</h3>
        <p>Maximiza la eficiencia operativa reduciendo o eliminando el repostaje, al tiempo que disminuye la mantención.</p>
      </div>

      <!-- Card 2 -->
      <div class="pilar-card reveal">
        <div class="pilar-card__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 10v3M6 6v11M10 3v18M14 8v8M18 5v14M22 10v3"/></svg>
        </div>
        <h3>30&times; más silencioso</h3>
        <p>Casi treinta y dos veces más silencioso que un generador diésel. Permite trabajar en horarios sensibles.</p>
      </div>

      <!-- Card 3 -->
      <div class="pilar-card reveal">
        <div class="pilar-card__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 22 12 2l10 20H2z"/><path d="M12 9v4M12 17h.01"/></svg>
        </div>
        <h3>Hasta &minus;90&nbsp;% CO&#8322;</h3>
        <p>Reduce las emisiones de carbono de tu faena hasta en un 90&nbsp;% y crea un entorno de trabajo más saludable.</p>
      </div>

      <!-- Card 4 -->
      <div class="pilar-card reveal">
        <div class="pilar-card__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </div>
        <h3>Hasta &minus;80&nbsp;% OPEX</h3>
        <p>Reduce significativamente los costos de combustible y mantención con una solución portátil y sostenible.</p>
      </div>

    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     4. CIFRAS / STATS
     ═══════════════════════════════════════════════════════════ -->
<section class="section section-dark cifras" id="cifras">
  <div class="wrap">
    <div class="cifras-row reveal">
      <div class="cifra">
        <span class="cifra__num spec">400+</span>
        <span class="cifra__label">ESS desplegados</span>
      </div>
      <div class="cifra">
        <span class="cifra__num spec">161.000</span>
        <span class="cifra__label">toneladas de CO&#8322; evitadas</span>
      </div>
      <div class="cifra">
        <span class="cifra__num spec">400+</span>
        <span class="cifra__label">proyectos energizados</span>
      </div>
      <div class="cifra">
        <span class="cifra__num spec">8</span>
        <span class="cifra__label">regiones con presencia</span>
      </div>
    </div>
    <div class="ctas reveal" style="justify-content:center;margin-top:48px">
      <a href="#cotizar" class="btn btn-outline">
        Habla con Enerterra
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     5. COSTO REAL
     ═══════════════════════════════════════════════════════════ -->
<section class="section section-soft" id="costo-real">
  <div class="wrap">
    <div class="costo-layout">
      <div class="costo-text">
        <p class="eyebrow reveal" style="color:var(--green-text)">Costo real</p>
        <h2 class="h-lg reveal" style="margin-top:16px">El diésel es más caro de lo que crees.</h2>
        <p class="lead reveal" style="margin-top:20px;color:var(--gris-500)">Cuando sumas combustible, mantención, transporte, mermas y horas de personal, un generador diésel cuesta hasta 3&times; más de lo presupuestado.</p>
      </div>
      <div class="costo-table-wrap reveal">
        <table class="compare-table">
          <thead>
            <tr>
              <th></th>
              <th class="compare-table__bess">BESS Ampd</th>
              <th class="compare-table__diesel">Generador diésel</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Combustible</td>
              <td class="compare-table__bess-val">Ninguno</td>
              <td class="compare-table__diesel-val">50&ndash;120 L/h</td>
            </tr>
            <tr>
              <td>Emisiones CO&#8322;</td>
              <td class="compare-table__bess-val">Cero locales</td>
              <td class="compare-table__diesel-val">130&ndash;300 kg/h</td>
            </tr>
            <tr>
              <td>Ruido</td>
              <td class="compare-table__bess-val">&lt;&nbsp;65 dB</td>
              <td class="compare-table__diesel-val">85&ndash;100+ dB</td>
            </tr>
            <tr>
              <td>Mantención</td>
              <td class="compare-table__bess-val">1&ndash;2/año</td>
              <td class="compare-table__diesel-val">Semanal</td>
            </tr>
            <tr>
              <td>Disponibilidad</td>
              <td class="compare-table__bess-val">&gt;99&nbsp;%</td>
              <td class="compare-table__diesel-val">~90&nbsp;%</td>
            </tr>
            <tr>
              <td>Vida útil</td>
              <td class="compare-table__bess-val">10 años</td>
              <td class="compare-table__diesel-val">3&ndash;5 años</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     6. SECTORES
     ═══════════════════════════════════════════════════════════ -->
<section class="section section-dark" id="sectores">
  <div class="wrap">
    <h2 class="h-md reveal">Sectores que ya confían en Ampd</h2>
    <div class="sectores-grid">

      <a href="#" class="sector-card reveal">
        <img src="/img/sector-mineria.jpg" alt="Minería" loading="lazy" />
        <div class="sector-card__scrim"></div>
        <div class="sector-card__arrow">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </div>
        <div class="sector-card__body">
          <h3>Minería</h3>
          <p>Energía sin emisiones para operaciones subterráneas y a cielo abierto.</p>
        </div>
      </a>

      <a href="#" class="sector-card reveal">
        <img src="/img/sector-construccion.jpg" alt="Construcción" loading="lazy" />
        <div class="sector-card__scrim"></div>
        <div class="sector-card__arrow">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </div>
        <div class="sector-card__body">
          <h3>Construcción</h3>
          <p>Equipos de obra silenciosos y sin diésel, ideales para zonas urbanas.</p>
        </div>
      </a>

      <a href="#" class="sector-card reveal">
        <img src="/img/sector-puertos.jpg" alt="Puertos" loading="lazy" />
        <div class="sector-card__scrim"></div>
        <div class="sector-card__arrow">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </div>
        <div class="sector-card__body">
          <h3>Puertos</h3>
          <p>Alimenta grúas y operaciones portuarias sin contaminar la zona costera.</p>
        </div>
      </a>

      <a href="#" class="sector-card reveal">
        <img src="/img/sector-industria.jpg" alt="Industria" loading="lazy" />
        <div class="sector-card__scrim"></div>
        <div class="sector-card__arrow">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </div>
        <div class="sector-card__body">
          <h3>Industria</h3>
          <p>Soluciones de respaldo y peak-shaving para plantas industriales.</p>
        </div>
      </a>

    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     7. PRODUCTOS
     ═══════════════════════════════════════════════════════════ -->
<section class="section" id="productos">
  <div class="wrap">
    <div class="productos-header">
      <div>
        <p class="eyebrow reveal" style="color:var(--green-text)">Nuestros productos</p>
        <h2 class="h-md reveal" style="margin-top:16px">Un sistema de almacenamiento para cada faena.</h2>
      </div>
      <a href="/productos" class="btn btn-outline reveal" style="align-self:end">
        Ver fichas de producto
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

    <div class="productos-list">
      {PRODUCTO_CARDS.map((p) => (
        <a href={`/productos/${p.slug}`} class="producto-row reveal">
          <div class="producto-row__img">
            <img src={p.img} alt={p.nombre} loading="lazy" />
          </div>
          <div class="producto-row__info">
            <div class="producto-row__name">
              <h3>{p.nombre}</h3>
              {p.tag && <span class="producto-row__tag">{p.tag}</span>}
            </div>
            <p class="producto-row__desc">
              {p.slug === 'ampd-200' && 'Sistema NextGen de formato intermedio. Refrigeración líquida, IP55, controlador solar integrado opcional.'}
              {p.slug === 'ampd-400' && 'Buque insignia de la gama NextGen. Máxima potencia, refrigeración líquida, IP55 y paralelo con generadores.'}
              {p.slug === 'enertainer' && 'El sistema original, en operación desde 2019. Más de 1.500.000 horas sin incidentes en industria pesada.'}
              {p.slug === 'ampd-silo' && 'Compacto, transportable y escalable. Conecta varias unidades en paralelo para mayor potencia y capacidad.'}
              {p.slug === 'software' && 'Estándar en todas las unidades. Monitoreo remoto, analítica, reporte de emisiones y programación cloud.'}
            </p>
          </div>
          <div class="producto-row__spec">
            <span class="spec producto-row__spec-num">{p.spec}</span>
            <span class="producto-row__spec-cont">{p.specCont}</span>
          </div>
          <div class="producto-row__arrow">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     8. DETALLE ENERTAINER
     ═══════════════════════════════════════════════════════════ -->
<section class="section" id="enertainer">
  <div class="wrap detalle-layout">
    <div class="detalle-img reveal">
      <img src="/img/producto-enertainer.jpg" alt="Enertainer en faena" loading="lazy" />
    </div>
    <div class="detalle-body">
      <p class="eyebrow reveal" style="color:var(--green-text)">Producto destacado</p>
      <h2 class="h-lg reveal" style="margin-top:16px">Enertainer: más de 1.500.000 horas sin incidentes</h2>
      <p class="lead reveal" style="margin-top:20px;color:var(--gris-500)">Nuestro sistema avanzado de almacenamiento de energía de generación original, que sigue entregando energía limpia y confiable a las industrias pesadas del mundo desde 2019. Disponible en múltiples configuraciones, está diseñado sin concesiones para entornos duros, dinámicos y con poco espacio.</p>
      <div class="ctas reveal" style="margin-top:32px">
        <a href="/productos/enertainer" class="btn btn-outline">
          Ver ficha completa
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     9. PILOTO 60 DIAS
     ═══════════════════════════════════════════════════════════ -->
<section class="section section-soft" id="piloto">
  <div class="wrap piloto">
    <p class="eyebrow reveal" style="color:var(--green-text)">Piloto 60 días</p>
    <h2 class="h-lg reveal" style="margin-top:16px;max-width:22ch">Prueba un Ampd en tu faena. Sin compromiso.</h2>
    <p class="lead reveal" style="margin-top:20px;color:var(--gris-500)">Te instalamos una unidad por 60 días. Medimos tu consumo real, calculamos el ahorro y te devolvemos una propuesta a la medida.</p>
    <div class="ctas reveal" style="margin-top:36px">
      <a href="#cotizar" class="btn btn-primary">
        Cotiza tu proyecto
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a href="#cotizar" class="btn btn-outline">Habla con un ingeniero</a>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     10. SUSTENTABILIDAD
     ═══════════════════════════════════════════════════════════ -->
<section class="sustentabilidad" id="sustentabilidad">
  <div class="sustentabilidad__bg">
    <img src="/img/sustentabilidad-faena.jpg" alt="" loading="lazy" />
  </div>
  <div class="sustentabilidad__scrim"></div>
  <div class="wrap sustentabilidad__inner">
    <p class="eyebrow reveal" style="color:var(--green-text)">Sustentabilidad</p>
    <h2 class="h-lg reveal" style="margin-top:16px;max-width:24ch">Energía sin emisiones para la industria del futuro</h2>
    <p class="lead reveal" style="margin-top:20px;color:var(--gris-500);max-width:52ch">Chile avanza hacia una economía baja en carbono. Con la regulación cada vez más estricta y los compromisos de descarbonización, reemplazar el diésel en faenas no es solo una decisión ecológica: es un imperativo de negocio.</p>
    <div class="ctas reveal" style="margin-top:36px">
      <a href="#cotizar" class="btn btn-outline">
        Conoce el impacto
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     11. CTA FINAL
     ═══════════════════════════════════════════════════════════ -->
<section class="section section-dark" id="cta-final">
  <div class="wrap cta-final">
    <h2 class="h-lg reveal" style="max-width:24ch">¿Listo para energizar tu próximo proyecto?</h2>
    <p class="lead reveal" style="margin-top:20px;color:var(--acero-300)">Tu especialista local puede entregarte un desglose completo de costos, ahorro de combustible y CO&#8322; evitado para tu faena.</p>
    <div class="ctas reveal" style="margin-top:36px">
      <a href="#cotizar" class="btn btn-primary">
        Cotiza tu proyecto
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a href="#cotizar" class="btn btn-outline">Habla con un ingeniero</a>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     12. FORM / COTIZAR
     ═══════════════════════════════════════════════════════════ -->
<section class="section" id="cotizar">
  <div class="wrap">
    <div class="form-layout">
      <div class="form-side">
        <p class="eyebrow reveal" style="color:var(--green-text)">Cotiza tu proyecto</p>
        <h2 class="h-md reveal" style="margin-top:16px">Cuéntanos de tu faena</h2>
        <form action="#" method="POST" class="form reveal">
          <div class="form__field">
            <label for="nombre">Nombre</label>
            <input type="text" id="nombre" name="nombre" required autocomplete="name" />
          </div>
          <div class="form__field">
            <label for="empresa">Empresa</label>
            <input type="text" id="empresa" name="empresa" required autocomplete="organization" />
          </div>
          <div class="form__field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required autocomplete="email" />
          </div>
          <div class="form__field">
            <label for="telefono">Teléfono</label>
            <input type="tel" id="telefono" name="telefono" autocomplete="tel" />
          </div>
          <div class="form__field form__field--full">
            <label for="mensaje">Mensaje</label>
            <textarea id="mensaje" name="mensaje" rows="4"></textarea>
          </div>
          <button type="submit" class="btn btn-primary">
            Enviar
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
        </form>
      </div>
      <div class="contact-info reveal">
        <h3>Contacto directo</h3>
        <dl class="contact-info__list">
          <div>
            <dt>Email</dt>
            <dd><a href="mailto:contacto@enerterra.cl">contacto@enerterra.cl</a></dd>
          </div>
          <div>
            <dt>Teléfono</dt>
            <dd><a href="tel:+56912345678">+56 9 1234 5678</a></dd>
          </div>
          <div>
            <dt>Oficina</dt>
            <dd>Santiago, Chile</dd>
          </div>
        </dl>
        <div class="contact-info__badge">
          <img src="/img/ampd-logo.png" alt="Ampd Energy" />
          <span>Representante oficial en Chile</span>
        </div>
      </div>
    </div>
  </div>
</section>

</Base>

<style>
/* ─────────────────────────────────────────────────────────────
   1. HERO
   ───────────────────────────────────────────────────────────── */
.hero {
  position: relative;
  min-height: 90vh;
  display: flex;
  align-items: center;
  overflow: hidden;
  background: var(--carbon);
  color: var(--white);
}
.hero__bg {
  position: absolute;
  inset: 0;
}
.hero__bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.hero__bg::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(11, 13, 16, .55) 0%,
    rgba(11, 13, 16, .70) 60%,
    rgba(11, 13, 16, .85) 100%
  );
}
.hero__inner {
  position: relative;
  z-index: 1;
  padding-block: 160px 100px;
  display: grid;
  gap: 24px;
  max-width: var(--container-max);
}
.hero__inner h1 { max-width: 14ch; }

.hero__badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 16px;
  border: 1px solid rgba(255, 255, 255, .35);
  border-radius: var(--radius-pill);
  font-size: 14px;
  font-weight: var(--weight-medium);
  width: fit-content;
  backdrop-filter: blur(8px);
  background: rgba(255, 255, 255, .06);
}
.hero__ampd-logo {
  height: 18px;
  width: auto;
  display: inline-block;
  vertical-align: middle;
}

/* ─────────────────────────────────────────────────────────────
   2. STATEMENT
   ───────────────────────────────────────────────────────────── */
.statement { text-align: center; }
.statement h2 { margin-inline: auto; }

/* ─────────────────────────────────────────────────────────────
   3. PILARES
   ───────────────────────────────────────────────────────────── */
.pilares-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--grid-gap);
  margin-top: 48px;
}
.pilar-card {
  background: #161A1F;
  border: 1px solid rgba(255, 255, 255, .14);
  border-radius: var(--radius-lg);
  padding: 32px;
  display: grid;
  gap: 12px;
  align-content: start;
}
.pilar-card__icon {
  width: 44px;
  height: 44px;
}
.pilar-card__icon svg {
  width: 100%;
  height: 100%;
}
.pilar-card h3 {
  font-size: var(--text-h3);
  font-weight: var(--weight-semibold);
  letter-spacing: var(--tracking-heading);
}
.pilar-card p {
  color: var(--acero-300);

---
/* ── Footer: dark, compact ── */
---

<footer class="footer">
  <div class="footer__inner wrap">
    <!-- Brand lockup -->
    <div class="footer__brand">
      <img src="/img/enerterra-logo-white.png" alt="Enerterra" class="footer__logo-enerterra" width="110" height="22" />
      <span class="footer__divider"></span>
      <span class="footer__rep">Representante oficial</span>
      <img src="/img/ampd-logo-white.svg" alt="Ampd Energy" class="footer__logo-ampd" width="64" height="16" />
    </div>

    <!-- Copyright -->
    <p class="footer__copy">
      &copy; 2026 Enerterra Chile SpA. Ampd Energy es marca registrada de Ampd Energy Ltd.
    </p>

    <!-- Back to top -->
    <a href="#" class="footer__top" aria-label="Volver al inicio">
      Volver al inicio
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M7 11V3M3.5 6.5L7 3l3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
</footer>

<style>
  .footer {
    background: var(--carbon-0);
    color: var(--acero-300);
    border-top: 1px solid rgba(255,255,255,.14);
    padding: 56px 0 40px;
    font-size: 14px;
    line-height: var(--leading-body);
  }

  .footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  /* ── Brand lockup ── */
  .footer__brand {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }
  .footer__logo-enerterra { height: 22px; width: auto; }
  .footer__logo-ampd { height: 16px; width: auto; }
  .footer__divider {
    width: 1px;
    height: 20px;
    background: rgba(255,255,255,.2);
    flex-shrink: 0;
  }
  .footer__rep {
    font-size: 11px;
    font-weight: var(--weight-medium);
    color: var(--acero-300);
    white-space: nowrap;
  }

  /* ── Copyright ── */
  .footer__copy {
    color: var(--acero-300);
    text-align: center;
    flex: 1;
    min-width: 0;
  }

  /* ── Back to top ── */
  .footer__top {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--acero-300);
    font-size: 14px;
    font-weight: var(--weight-medium);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .footer__top:hover {
    color: var(--blanco-0);
  }
  .footer__top svg {
    transition: transform var(--dur-base) var(--ease-out);
  }
  .footer__top:hover svg {
    transform: translateY(-2px);
  }

  /* ── Responsive ── */
  @media (max-width: 999px) {
    .footer__inner {
      flex-direction: column;
      text-align: center;
      gap: 20px;
    }
    .footer__copy {
      text-align: center;
      order: 2;
    }
    .footer__brand {
      order: 0;
    }
    .footer__top {
      order: 1;
    }
  }

  @media (max-width: 640px) {
    .footer {
      padding: 40px 0 32px;
    }
    .footer__brand {
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
    }
  }
</style>
